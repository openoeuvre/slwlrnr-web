# Nothing here is required to run the local mock build.
# These are the seams the mock adapters will eventually be swapped onto.

# --- Shopify (commerce: /gallery) ---
# Storefront API, used by src/lib/commerce.ts
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-04

# --- Supabase (accounts, entitlements: /learn, /create) ---
# Project Settings → API Keys (new-style keys, not the legacy anon/service_role).
# The secret key bypasses row-level security: server only, never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Stripe (subscriptions: /learn $10, /create $30) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_LEARN=
NEXT_PUBLIC_STRIPE_PRICE_STUDIO=

# --- Create (inference service; Modal URL in production) ---
INFERENCE_URL=http://127.0.0.1:8010

# --- Mock session (remove when Supabase auth ships) ---
# Deployed (production) builds ignore the dev session switcher unless this is
# "true". Only set it on a Vercel environment that has Deployment Protection.
NEXT_PUBLIC_ENABLE_MOCK_SESSION=
