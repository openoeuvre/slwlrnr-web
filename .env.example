# Nothing here is required to run the local mock build.
# These are the seams the mock adapters will eventually be swapped onto.

# --- Shopify (commerce: /gallery) ---
# Storefront API, used by src/lib/commerce.ts
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-04

# --- Supabase (accounts, entitlements: /learn, /create) ---
# Project Settings → API Keys (new-style keys, not the legacy anon/service_role).
# The secret key bypasses row-level security: server only, never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Stripe (memberships: Learn $10, Studio $30, bundle $35) ---
# Prices are found by lookup key (src/lib/billing/plans.ts) — no price IDs here.
# Test keys start sk_test_ / whsec_. Server only.
STRIPE_SECRET_KEY=
# Locally: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# On Vercel: from the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Public base URL for Stripe redirects. Optional locally; set in production.
NEXT_PUBLIC_SITE_URL=

# --- Create (inference service; Modal URL in production) ---
INFERENCE_URL=http://127.0.0.1:8010

# --- Dev grants (remove once Stripe is live) ---
# Lets a signed-in tester grant their own account Learn/Studio. Ignored by
# production builds unless "true" — only set it on a protected environment.
NEXT_PUBLIC_ENABLE_DEV_GRANTS=
